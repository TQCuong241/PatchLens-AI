{
  "name": "@patchlens-ai/dev",
  "version": "0.1.0",
  "description": "One-package development integration and CLI for PatchLens AI.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "import": "./dist/next.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    }
  },
  "bin": {
    "patchlens": "./dist/bin.js",
    "patchlens-mcp": "./dist/mcp-bin.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@patchlens-ai/agent-protocol": "workspace:*",
    "@patchlens-ai/cli": "workspace:*",
    "@patchlens-ai/compiler-next": "workspace:*",
    "@patchlens-ai/compiler-vite": "workspace:*",
    "@patchlens-ai/inspector-runtime": "workspace:*",
    "@patchlens-ai/mcp-server": "workspace:*"
  },
  "peerDependencies": {
    "vite": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "keywords": [
    "visual-coding",
    "ai",
    "development-tools",
    "patchlens"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TQCuong241/PatchLens-AI.git",
    "directory": "packages/dev"
  },
  "homepage": "https://github.com/TQCuong241/PatchLens-AI#readme",
  "bugs": {
    "url": "https://github.com/TQCuong241/PatchLens-AI/issues"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
