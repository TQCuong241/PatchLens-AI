{
  "name": "@patchlens-ai/cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "patchlens": "./dist/bin.js"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "pnpm --filter @patchlens-ai/agent-protocol build && pnpm --filter @patchlens-ai/mcp-server build && pnpm build && node --test dist/index.test.js"
  },
  "dependencies": {
    "@patchlens-ai/daemon": "workspace:*",
    "@patchlens-ai/mcp-server": "workspace:*",
    "@patchlens-ai/studio": "workspace:*"
  }
}
