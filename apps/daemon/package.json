{
  "name": "@patchlens-ai/daemon",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": ["dist"],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@patchlens-ai/agent-protocol": "workspace:*",
    "@patchlens-ai/coding-provider": "workspace:*",
    "@patchlens-ai/patch-transaction": "workspace:*"
  }
}
